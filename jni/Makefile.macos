# Configuration for iPhone OS, making static libs
# this will generate both iPhone (arm) and iPhoneSimulator (i686) libs

TARGET = echo
INCLUDE=-I.
SRCS=libecho.c

INSTALLDIR_HEADERS=libecho/include/
INSTALLDIR_LIBRARY=libecho/libcombined/
INSTALLDIR=`$(PLATFORM_CONFIG) --installdir`
INSTALL_HEADERS=libecho.h

ifeq ($(CUSTOM_PLATFORM_CONFIG),)
PLATFORM_CONFIG=../../macos_platform_config.sh
else
PLATFORM_CONFIG=$(CUSTOM_PLATFORM_CONFIG)
endif

STD_CFLAGS   = `$(PLATFORM_CONFIG) --cflags`
STD_CXXFLAGS = `$(PLATFORM_CONFIG) --cxxflags`

MACOS_DEPLOYMENT_TARGET = `$(PLATFORM_CONFIG) --minversion`

ARCH_I386 = i386
ARCH_X86_64 = x86_64

SDKROOT = `$(PLATFORM_CONFIG) --sysroot`

EXTRA_CFLAGS   += $(INCLUDE)
SRCS_TO_COMPILE=$(SRCS)

EXTRA_CFLAGS += -isysroot $(SDKROOT)
EXTRA_CFLAGS += -mmacosx-version-min=$(MACOS_DEPLOYMENT_TARGET)

AR = `$(PLATFORM_CONFIG) --ar`

CC = `$(PLATFORM_CONFIG) --cc`
CXX = `$(PLATFORM_CONFIG) --cxx`
LIBTOOL = `$(PLATFORM_CONFIG) --libtool`
LIPO = `$(PLATFORM_CONFIG) --lipo`

CFLAGS = $(STD_CFLAGS) $(EXTRA_CFLAGS)
CXXFLAGS += $(STD_CXXFLAGS) $(EXTRA_CFLAGS)

STATICLIB = lib$(TARGET).a

.SUFFIXES: .o-i386 .o-x86_64
MODULES_i386 = $(SRCS_TO_COMPILE:.c=.o-i386)
MODULES_i386 := $(MODULES_i386:.cpp=.o-i386)
MODULES_x86_64 = $(SRCS_TO_COMPILE:.c=.o-x86_64)
MODULES_x86_64 := $(MODULES_x86_64:.cpp=.o-x86_64)

default: all

all: $(TARGET)

$(TARGET): $(STATICLIB)

$(STATICLIB): $(STATICLIB)-i386 $(STATICLIB)-x86_64
	$(LIPO) -create $(STATICLIB)-i386 $(STATICLIB)-x86_64 -output $(STATICLIB)

$(STATICLIB)-i386: $(MODULES_i386)
	$(LIBTOOL) -arch_only $(ARCH_I386) -o $@ $(MODULES_i386)

$(STATICLIB)-x86_64: $(MODULES_x86_64)
	$(LIBTOOL) -arch_only $(ARCH_X86_64) -o $@ $(MODULES_x86_64)

.c.o-i386:
	@echo " (CC-i386) $<"
	@$(CC) -arch $(ARCH_I386) $(CFLAGS) -c $< -o $@

.cpp.o-i386:
	@echo " (C++-i386) $<"
	@$(CXX) -arch $(ARCH_I386) $(CXXFLAGS) -c $< -o $@

.c.o-x86_64:
	@echo " (CC-x86_64) $<"
	@$(CC) -arch $(ARCH_X86_64) $(CFLAGS) -c $< -o $@

.cpp.o-x86_64:
	@echo " (C++-x86_64) $<"
	@$(CXX) -arch $(ARCH_X86_64) $(CXXFLAGS) -c $< -o $@

combine_libs:
	$(LIPO) -info $(STATICLIB)
	
install: combine_libs
	mkdir -p $(INSTALLDIR)/$(INSTALLDIR_HEADERS)
	mkdir -p $(INSTALLDIR)/$(INSTALLDIR_LIBRARY)
	cp $(INSTALL_HEADERS) $(INSTALLDIR)/$(INSTALLDIR_HEADERS)
	cp $(STATICLIB) $(INSTALLDIR)/$(INSTALLDIR_LIBRARY)
	
clean:
	rm -f core Dist/*.* u2dtmp* $(MODULES_i386) $(MODULES_x86_64) $(STATICLIB) $(STATICLIB)-i386 $(STATICLIB)-x86_64 

